<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ TFM gives us the WinRT projections (Windows.Media.Control) with no extra packages. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MusicOverlay</RootNamespace>
    <AssemblyName>MusicOverlay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <Product>Music Overlay</Product>
    <Description>Borderless now-playing overlay for Windows</Description>
    <Copyright>Copyright (c) 2026 Jam7170</Copyright>

    <!-- Keep the footprint small: workstation, non-concurrent GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so single-file builds carry the font. -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
